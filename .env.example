# ============================================================================
# QURANPULSE v6.0 - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Instructions:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Fill in the required secrets.
# 3. Restart the dev server (npm run dev) or bot server (npm run bot).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE SUPABASE CONFIG (REQUIRED)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://bomjkgyrkvuivqodzqzf.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# For backend scripts (e.g., database seeding) ONLY. Do not expose in VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----------------------------------------------------------------------------
# 2. BOT INTEGRATION (REQUIRED FOR NPM RUN BOT)
# ----------------------------------------------------------------------------
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# WhatsApp uses local authentication (.wwebjs_auth folder), no key needed.

# ----------------------------------------------------------------------------
# 3. AI SERVICES (REQUIRED FOR USTAZ AI)
# ----------------------------------------------------------------------------
# Google Gemini (Primary Intelligence)
VITE_GEMINI_API_KEY=your_gemini_key_here

# Groq (Ultra-Fast Inference Layer)
VITE_GROQ_API_KEY=your_groq_key_here

# ElevenLabs (Voice Synthesis)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ----------------------------------------------------------------------------
# 4. MONITORING & ANALYTICS (OPTIONAL)
# ----------------------------------------------------------------------------
VITE_SENTRY_DSN=
VITE_GOOGLE_SHEET_API_KEY=

# ----------------------------------------------------------------------------
# 5. ADMIN & SECURITY
# ----------------------------------------------------------------------------
# Comma-separated list of User UUIDs allowed to access /admin
VITE_ADMIN_USER_IDS=user_uuid_1,user_uuid_2
VITE_TEST_USER_PW=password123

# Error Tracking & Analytics
VITE_SENTRY_DSN=replace_me
VITE_POSTHOG_KEY=replace_me
VITE_POSTHOG_HOST=https://app.posthog.com

# ----------------------------------------------------------------------------
# 6. SYSTEM CONFIG
# ----------------------------------------------------------------------------
NODE_ENV=development
VITE_APP_VERSION=6.0.0
VITE_SITE_URL=http://localhost:5173
