        "name_en": "True Concealment",
        "category": "nun_sakinah",
        "description_ms": "Menyembunyikan bunyi Nun Sakinah atau Tanwin dengan dengung (ghunnah) apabila bertemu 15 huruf Ikhfa'. Dengung mestilah 2 harakat.",
        "description_en": "Concealing the sound of Nun Sakinah or Tanwin with a nasal sound (ghunnah) when meeting the 15 Ikhfa' letters. The ghunnah should be 2 counts.",
        "examples": [
            {
                "arabic": "مِنْ تَحْتِهَا",
                "transliteration": "min tahtiha",
                "surah_ayah": "Al-Baqarah: 25"
            },
            {
                "arabic": "أَنْثَى",
                "transliteration": "untha",
                "surah_ayah": "An-Nisa: 11"
            },
            {
                "arabic": "مَنْ ذَا",
                "transliteration": "man dza",
                "surah_ayah": "Al-Baqarah: 255"
            }
        ],
        "common_mistakes": [
            "Tidak mengeluarkan dengung",
            "Dengung terlalu panjang atau pendek",
            "Mengizharkan huruf dengan jelas"
        ],
        "priority": 1
    },
