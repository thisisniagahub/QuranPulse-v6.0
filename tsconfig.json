{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "module": "ESNext",
    "types": ["node", "vite/client", "react", "react-dom"],
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite-env.d.ts", "src/jest.d.ts", "src/test.d.ts", "src/global.d.ts", "src/modules.d.ts", "src/types.d.ts"],
  "exclude": ["node_modules", "apps/admin-dashboard", "admin-dashboard-new"]
}
